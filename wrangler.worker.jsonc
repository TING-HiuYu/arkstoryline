{
  "name": "arkstoryline",
  "compatibility_date": "2026-05-26",
  "main": "worker/portal.mjs",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/ark/storyline", "/ark/storyline/*"],
  },
}
